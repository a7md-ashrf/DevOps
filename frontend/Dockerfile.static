# syntax=docker/dockerfile:1
# =============================================================================
# FRONTEND — STATIC MODE
# Serves the compiled React bundle from nginx. NO Node runtime in production.
#
#   deps    — npm ci (cached until package-lock.json changes)
#   build   — typecheck + vite build -> dist/
#   static  — nginx-unprivileged serving dist/ as a non-root user
#
# Choose this mode for: lowest footprint, simplest ops, static hosting model.
# =============================================================================
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# An explicit `id` even though nothing races here today: the final `static`
# stage is nginx and runs no npm, so this is the only cache mount in the file.
# Naming it keeps the pattern uniform across the Dockerfiles and stops the
# sibling-stage race in backend/Dockerfile from being reintroduced by copy-paste.
RUN --mount=type=cache,target=/root/.npm,id=npm-dev \
    npm ci

FROM deps AS build
COPY . .
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS static
COPY nginx-static.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
