# =============================================================================
# devops-reference — environment template
# -----------------------------------------------------------------------------
# Setup:  cp .env.example .env   (or `make setup`), then change every CHANGE-ME.
# Rules:  .env is gitignored. Production values are injected at deploy time by
#         the deploy workflow — never baked into Docker images, never committed.
#         Full variable reference: docs/file-reference.md
# =============================================================================

# ---- Frontend mode (the build/env flag that selects the architecture) --------
# static = React build served by an nginx container (no Node runtime in prod)
# server = same build served by a small Node/Express static-server container
# Drives: frontend/Dockerfile.${FRONTEND_MODE}, the frontend image name, and
#         which nginx site template the edge loads (NGINX_MODE mirrors it).
FRONTEND_MODE=static

# ---- Compose -----------------------------------------------------------------
# Docker Compose derives its project name (container/network/volume names)
# from this instead of the directory name, so names are stable no matter
# where the command is run from.
COMPOSE_PROJECT_NAME=devops-reference

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=app
# CHANGE-ME: generate with `openssl rand -hex 24` (URL-safe — base64 output can
# contain `/` or `+`, which breaks the DATABASE_URL parser)
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=appdb
# Dev-only host binding so GUI clients / host-run tooling can reach the DB.
# The production override removes this port entirely (see docs/architecture.md).
POSTGRES_HOST_PORT=127.0.0.1:5432

# ---- Backend -----------------------------------------------------------------
# NODE_ENV=production is set by infra/docker-compose.prod.yml — do not set it here.
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (CORS). Dev = Vite + edge.
# Prod example: CORS_ORIGINS=https://example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Images (used by docker-compose.prod.yml and infra/deploy/deploy.sh) ------
# IMAGE_TAG is overwritten by the deploy script with the exact sha-<shortsha>
# tag built by CI — that pinning is what makes rollback a one-line operation.
IMAGE_REPO=ghcr.io/YOUR_GH_USERNAME/devops-reference
IMAGE_TAG=main

# ---- Nginx / TLS -------------------------------------------------------------
# Your real domain. Used for the TLS certificate CN/SAN and Host header.
DOMAIN=example.com
# 0 in dev/local. Set to 1 in the VPS .env AFTER the first certificate is
# issued — the nginx entrypoint then adds the HTTP->HTTPS redirect.
ENABLE_TLS_REDIRECT=0
# Host ports for the dev stack. Production maps 80->8080 and 443->8443 instead.
HTTP_PORT=8080
HTTPS_PORT=8443
# Dev convenience binding so `make dev-api` (host process) works.
# Removed entirely in production.
BACKEND_HOST_PORT=127.0.0.1:3000
