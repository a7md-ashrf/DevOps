# EditorConfig helps maintain consistent whitespace across editors/OSes.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Makefile]
# Makefiles require TAB indentation — spaces break every target.
indent_style = tab

[*.md]
# Markdown uses two trailing spaces for hard line breaks.
trim_trailing_whitespace = false
