# =============================================================================
# Site configuration — SERVER frontend mode (UI served by a Node process).
# Rendered into /etc/nginx/conf.d/10-site.conf by docker-entrypoint.d/45.
#
# Structurally identical to the static template on purpose: the mode only
# changes WHICH origin sits behind `location /` (see snippets/locations-*).
# Keeping one file per mode makes both modes diffable at a glance:
#   diff templates/static-mode.conf.template templates/server-mode.conf.template
# =============================================================================

# ---- HTTPS -------------------------------------------------------------------
server {
    listen 8443 ssl;
    http2 on;
    server_name ${DOMAIN} _;

    ssl_certificate ${TLS_CERT};
    ssl_certificate_key ${TLS_KEY};

    include /etc/nginx/snippets/tls-hardening.conf;
    include /etc/nginx/snippets/security-headers.conf;

    limit_req zone=site_limit burst=60 nodelay;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    include /etc/nginx/snippets/locations-server.conf;
}

# ---- HTTP --------------------------------------------------------------------
server {
    listen 8080;
    server_name ${DOMAIN} _;

    include /etc/nginx/snippets/security-headers.conf;

    limit_req zone=site_limit burst=60 nodelay;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        access_log off;
    }

    include /etc/nginx/conf.d/http-app.inc;
}
